{
  "compilerOptions": {
    "composite": true,
    // A composite project has to emit, so it emits somewhere harmless.
    // The default put vite.config.js beside the source, and Vite resolves
    // .js before .ts, so the build artifact silently shadowed the real
    // config: edits to vite.config.ts did nothing in dev until the next
    // build regenerated the stale copy over them.
    "outDir": "./node_modules/.tmp/tsconfig-node",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "vite.config.ts"
  ]
}
